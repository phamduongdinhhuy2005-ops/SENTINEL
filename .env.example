# SENTINEL - Environment Variables
# Copy this file to .env and fill in your API keys.
# Keys are OPTIONAL: without them the local knowledge base still works.
# With at least one key, the LLM tier (Layer 2) activates automatically.
#
# Recommended starting point: Groq first, then Gemini.
# Default provider priority: groq -> gemini -> openrouter -> together -> huggingface

# Allow scanning local/private targets such as localhost and private IP ranges.
# Set to false in production if you want to block private/reserved targets.
SENTINEL_ALLOW_PRIVATE_TARGETS=true

# -- LLM Provider API Keys ----------------------------------------------------

# Groq - https://console.groq.com
VITE_GROQ_API_KEY=

# Google Gemini - https://aistudio.google.com
VITE_GEMINI_API_KEY=

# OpenRouter - https://openrouter.ai
VITE_OPENROUTER_API_KEY=

# Together.ai - https://api.together.xyz
VITE_TOGETHER_API_KEY=

# HuggingFace Inference API - https://huggingface.co/settings/tokens
VITE_HF_API_KEY=

# -- LLM Router Config (all optional, defaults shown) ------------------------

# Provider selection order (comma-separated IDs)
# VITE_LLM_PROVIDER_PRIORITY=groq,gemini,openrouter,together,huggingface

# Request timeout per provider (ms)
# VITE_LLM_TIMEOUT_MS=20000

# Max retries per provider on transient error
# VITE_LLM_MAX_RETRIES=2

# Cache TTL for repeated questions (ms)
# VITE_LLM_CACHE_TTL_MS=600000

# Enable cross-checking with 2 providers (true/false)
# VITE_LLM_CROSS_CHECK_ENABLED=true

# Confidence threshold below which cross-check is triggered (0-1)
# VITE_LLM_CROSS_CHECK_THRESHOLD=0.55

# Max tokens to send in prompt (input guard)
# VITE_LLM_MAX_INPUT_TOKENS=2500

# Max tokens to request from provider (output guard)
# VITE_LLM_MAX_OUTPUT_TOKENS=2048

# Conversation turns sent to the LLM (history window)
# VITE_LLM_HISTORY_TURNS=20

# -- Model overrides ----------------------------------------------------------

# Groq
VITE_GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-70b-versatile,llama3-70b-8192,llama-3.1-8b-instant
VITE_GROQ_TIMEOUT_MS=20000

# Gemini
VITE_GEMINI_MODELS=gemini-2.0-flash,gemini-2.0-flash-lite,gemini-1.5-flash
VITE_GEMINI_TIMEOUT_MS=20000

# OpenRouter
VITE_OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free,meta-llama/llama-3.1-8b-instruct:free,mistralai/mistral-7b-instruct:free,google/gemma-3-27b-it:free
VITE_OPENROUTER_TIMEOUT_MS=25000

# Together.ai
VITE_TOGETHER_MODELS=meta-llama/Llama-3.3-70B-Instruct-Turbo-Free,meta-llama/Llama-3.1-8B-Instruct-Turbo-Free
VITE_TOGETHER_TIMEOUT_MS=20000

# HuggingFace
VITE_HF_MODELS=meta-llama/Llama-3.1-8B-Instruct,Qwen/Qwen2.5-7B-Instruct,microsoft/Phi-3-mini-4k-instruct
VITE_HF_TIMEOUT_MS=35000
